NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://paylens:paylens@localhost:5432/paylens
REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:3000

AUTH_ACCESS_TOKEN_SECRET=replace-with-a-strong-32-character-secret
AUTH_COOKIE_SAME_SITE=lax

LOG_LEVEL=debug

# Required in production; development and test use the in-memory outbox when absent.
SMTP_URL=smtps://my-user:my-password@smtp.example.com:465
EMAIL_FROM=PayLens <noreply@paylens.local>

# Optional Google OIDC. Configure all three or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional observability exporter. Leave blank when no collector is deployed.
OTEL_EXPORTER_OTLP_ENDPOINT=


FILE_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_STORAGE_BUCKET=paylens
FILE_STORAGE_REGION=auto
