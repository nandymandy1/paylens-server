NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://paylens:paylens@localhost:5432/paylens
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
EXECUTION_TRACE_ENABLED=true
# Public frontend origin used for email links and OAuth redirects.
FRONTEND_URL=http://localhost:3000
# Strong random secret, minimum 32 characters. Required outside test env.
AUTH_ACCESS_TOKEN_SECRET=change-me-to-a-32-plus-character-secret
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1209600
# Cookie posture for separately deployed frontend/backend (allowlist enforced via CORS_ORIGINS).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
# SMTP is all-or-nothing; when absent, mail stays in memory (dev/test only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PayLens <noreply@paylens.local>
# Google OIDC is all-or-nothing; when absent, Google login is cleanly disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Risk-sensitive per-endpoint throttle limits (requests per 60s).
THROTTLE_LOGIN_LIMIT=10
THROTTLE_REGISTER_LIMIT=5
THROTTLE_FORGOT_LIMIT=5
THROTTLE_RESEND_LIMIT=5
THROTTLE_RESET_LIMIT=10
THROTTLE_INVITE_LIMIT=10
THROTTLE_GOOGLE_LIMIT=20
THROTTLE_REFRESH_LIMIT=30
