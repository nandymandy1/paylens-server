generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  TENANT_OWNER
  HR_ADMIN
  HR_MANAGER
  MANAGER
  EMPLOYEE
  VIEWER_AUDITOR
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum OAuthProvider {
  GOOGLE
}

enum AuthActionTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuthAuditAction {
  USER_REGISTERED
  EMAIL_VERIFIED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  GOOGLE_ACCOUNT_LINKED
  ORGANIZATION_CREATED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  MEMBERSHIP_ROLE_CHANGED
  ORGANIZATION_SWITCHED
  SESSION_REVOKED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum CompensationChangeReason {
  INITIAL
  ANNUAL_REVIEW
  PROMOTION
  MARKET_ADJUSTMENT
  CORRECTION
  OTHER
}

enum EmployeeTransferFormat {
  CSV
  XLSX
}

enum EmployeeExportStatus {
  QUEUED
  PROCESSING
  PAUSING
  PAUSED
  CANCELLING
  CANCELLED
  FINALIZING
  COMPLETED
  FAILED
  EXPIRED
}

enum EmployeeImportStatus {
  AWAITING_UPLOAD
  QUEUED
  VALIDATING
  PAUSING
  PAUSED
  READY_FOR_REVIEW
  APPLY_QUEUED
  APPLYING
  CANCELLING
  CANCELLED
  CANCELLED_PARTIAL
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  EXPIRED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String?
  firstName      String
  lastName       String
  emailVerifiedAt DateTime?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  memberships    OrganizationMembership[]
  oauthIdentities OAuthIdentity[]
  actionTokens   AuthActionToken[]
  sentInvitations OrganizationInvitation[] @relation("InvitationInviter")
  auditActorEvents  AuthAuditEvent[] @relation("AuditActor")
  auditTargetEvents AuthAuditEvent[] @relation("AuditTarget")
  compensationChanges CompensationHistory[] @relation("CompensationHistoryChangedBy")
  requestedExports   EmployeeExport[]       @relation("EmployeeExportRequester")
  requestedImports   EmployeeImport[]       @relation("EmployeeImportRequester")

  @@index([status])
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  departments Department[]
  mutationIdempotencies MutationIdempotency[]
  employees   Employee[]
  employeeExports EmployeeExport[]
  employeeImports EmployeeImport[]

  @@index([status])
}

/// Durable replay boundary for externally retried, tenant-scoped mutations.
/// A completed record always points at the resource created or changed inside
/// the same transaction; it is deliberately not a general workflow engine.
model MutationIdempotency {
  id             String   @id @default(cuid())
  organizationId String
  operation      String   @db.VarChar(80)
  idempotencyKey String   @db.VarChar(128)
  requestHash    String   @db.VarChar(64)
  resourceId     String?
  responseStatus Int      @default(200)
  responsePayload Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, operation, idempotencyKey])
  @@index([organizationId, operation, createdAt])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
}

model OAuthIdentity {
  id              String        @id @default(cuid())
  userId          String
  provider        OAuthProvider
  providerSubject String
  providerEmail   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([provider, providerEmail])
}

model AuthActionToken {
  id         String              @id @default(cuid())
  userId     String
  type       AuthActionTokenType
  tokenHash  String              @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model OrganizationInvitation {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  role            MembershipRole
  tokenHash       String           @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, acceptedAt])
  @@index([expiresAt])
}

model AuthAuditEvent {
  id             String          @id @default(cuid())
  action         AuthAuditAction
  actorUserId    String?
  targetUserId   String?
  organizationId String?
  requestId      String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  actor  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorUserId])
  @@index([organizationId])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  normalizedName String   @default(dbgenerated())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, code])
  @@unique([organizationId, normalizedName])
  @@unique([organizationId, id])
  @@index([organizationId, name, id])
}

model EmployeeExport {
  id                      String               @id @default(cuid())
  organizationId          String
  requestedByUserId       String
  format                  EmployeeTransferFormat
  status                  EmployeeExportStatus @default(QUEUED)
  totalRows               Int                  @default(0)
  processedRows           Int                  @default(0)
  progressPercent         Int                  @default(0)
  lastProcessedEmployeeId String?
  nextBatchNumber         Int                  @default(1)
  finalObjectKey          String?
  fileName                String?
  fileSizeBytes           Int?
  errorCode               String?
  createdAt               DateTime             @default(now())
  startedAt               DateTime?
  completedAt             DateTime?
  expiresAt               DateTime?
  updatedAt               DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("EmployeeExportRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, requestedByUserId, createdAt])
  @@index([organizationId, status, createdAt])
}

model EmployeeImport {
  id                       String               @id @default(cuid())
  organizationId           String
  requestedByUserId        String
  format                   EmployeeTransferFormat
  status                   EmployeeImportStatus @default(AWAITING_UPLOAD)
  originalFileName         String
  sourceObjectKey          String
  normalizedPrefix         String?
  validationReportObjectKey String?
  applyReportObjectKey     String?
  totalRows                Int                  @default(0)
  validatedRows            Int                  @default(0)
  validRows                Int                  @default(0)
  invalidRows              Int                  @default(0)
  createRows               Int                  @default(0)
  updateRows               Int                  @default(0)
  unchangedRows            Int                  @default(0)
  processedRows            Int                  @default(0)
  createdRows              Int                  @default(0)
  updatedRows              Int                  @default(0)
  failedRows               Int                  @default(0)
  lastProcessedRow         Int                  @default(0)
  nextBatchNumber          Int                  @default(1)
  createMissingDepartments Boolean              @default(false)
  previewSummary           Json?
  createdAt                DateTime             @default(now())
  uploadedAt               DateTime?
  validatedAt              DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  expiresAt                DateTime?
  updatedAt                DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("EmployeeImportRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, requestedByUserId, createdAt])
  @@index([organizationId, status, createdAt])
}

model Employee {
  id               String         @id @default(cuid())
  organizationId   String
  departmentId     String
  employeeNumber   String
  firstName        String
  lastName         String
  workEmail        String?
  jobTitle         String
  level            String?
  countryCode      String         @db.VarChar(2)
  employmentType   EmploymentType
  status           EmployeeStatus
  hireDate         DateTime       @db.Date
  terminationDate  DateTime?      @db.Date
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department          Department            @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  currentCompensation EmployeeCompensation?
  compensationHistory CompensationHistory[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, workEmail])
  @@index([organizationId, status, lastName, id])
  @@index([organizationId, departmentId, lastName, id])
  @@index([organizationId, countryCode, lastName, id])
}

model EmployeeCompensation {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  annualBaseSalary Decimal  @db.Decimal(19, 2)
  currency         String   @db.VarChar(3)
  effectiveFrom    DateTime @db.Date
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([annualBaseSalary, id])
}

model CompensationHistory {
  id                       String                   @id @default(cuid())
  employeeId               String
  version                  Int
  previousAnnualBaseSalary Decimal?                 @db.Decimal(19, 2)
  newAnnualBaseSalary      Decimal                  @db.Decimal(19, 2)
  previousCurrency         String?                  @db.VarChar(3)
  newCurrency              String                   @db.VarChar(3)
  previousEffectiveFrom    DateTime?                @db.Date
  effectiveFrom            DateTime                 @db.Date
  reason                   CompensationChangeReason
  note                     String?
  changedByUserId          String?
  createdAt                DateTime                 @default(now())

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  changedByUser User?    @relation("CompensationHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, version])
  @@index([employeeId, effectiveFrom, id])
}
